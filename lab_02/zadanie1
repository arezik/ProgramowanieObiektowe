import java.util.Scanner;

public class Main {
    public static class Dog {
        private String name;
        private String breed;
        private int age;

        public Dog(String name, String breed, int age) {
            this.name = name;
            this.breed = breed;
            this.age = age;
        }
        public void bark() {
            System.out.println("Szczek szczek lalalala");
        }
        public void showInformation() {
            System.out.println("Imię: " + name + " | Rasa: " + breed + " | Wiek: " + age + " lat");
        }
    }

    public static void main(String[] args) {
        Dog myDog = new Dog("Szarik", "Owczarek Niemiecki", 5);

        myDog.showInformation();
        myDog.bark();
    }
}
